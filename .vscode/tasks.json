{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build counter",
      "type": "retro-z80-build",
      "source": "examples/counter/counter.asm",
      "load": "8000",
      "includes": [
        "firmware/include"
      ],
      "problemMatcher": "$sjasmplus"
    },
    {
      "label": "build blitter",
      "type": "retro-z80-build",
      "source": "examples/blitter/blitter.asm",
      "load": "8000",
      "includes": [
        "firmware/include"
      ],
      "problemMatcher": "$sjasmplus"
    },
    {
      "label": "build sprite demo",
      "type": "retro-z80-build",
      "source": "examples/sprdemo/boing.asm",
      "load": "2000",
      "includes": [
        "firmware/include"
      ],
      "problemMatcher": "$sjasmplus"
    },
    {
      "label": "build fast3d",
      "type": "shell",
      "command": "python",
      "args": [
        "examples/fast3d/build.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$sjasmplus"
    },
    {
      "label": "build fast3d with the geometry unit",
      "type": "shell",
      "command": "python",
      "args": [
        "examples/fast3d/build.py",
        "--geom"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$sjasmplus"
    }
  ]
}
